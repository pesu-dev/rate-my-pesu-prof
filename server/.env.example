# ─── Server Configuration ───────────────────────────────────────
PORT=5000

# ─── MongoDB ─────────────────────────────────────────────────────
# Paste your MongoDB Atlas connection string here (never commit the real one)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ─── JWT ─────────────────────────────────────────────────────────
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_strong_random_secret

# ─── Local Dev Admin Seed ────────────────────────────────────────
# Only used in development (NODE_ENV !== "production").
# Set these to bootstrap a local admin account on first run.
# Leave blank to skip seeding.
SEED_ADMIN_USERNAME=your_admin_username
SEED_ADMIN_PASSWORD=your_strong_password_here

# ─── Environment ─────────────────────────────────────────────────
# Set to "production" on your deployment platform to disable seeding
NODE_ENV=development
